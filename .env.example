# Шаблон для docker-compose. Скопировать в .env и заполнить. .env в git не попадает.

MYSQL_ROOT_PASSWORD=change-me-root
DB_NAME=chat
DB_USER=chat
DB_PASSWORD=change-me-db

# Длинная случайная строка, например: openssl rand -hex 32
SESSION_SECRET=change-me-session

# Порт на хосте для nginx
WEB_PORT=80
